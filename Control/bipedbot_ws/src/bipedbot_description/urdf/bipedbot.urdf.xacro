    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0.0125 -0.0365 -0.0256" rpy="-2.1817 0.0000 -3.1416"/>
    <geometry>
      <box size="0.0250 0.0668 0.1560"/>
    </geometry>
  </collision>
</link>

<link name="right_bottom_leg_1">
  <inertial>
    <origin xyz="-0.0049999999999989775 0.03342953324706922 -0.04524843328414291" rpy="0 0 0"/>
    <mass value="0.06694057104242657"/>
    <inertia ixx="0.000154" iyy="9.6e-05" izz="5.9e-05" ixy="0.0" iyz="6e-05" ixz="-0.0"/>
