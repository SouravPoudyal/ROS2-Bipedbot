  <visual>
    <origin xyz="0.04 0.01 -0.199931" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/left_top_leg_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="-0.0125 -0.0365 -0.0256" rpy="-2.1817 0.0000 -3.1416"/>
    <geometry>
      <box size="0.0250 0.0668 0.1560"/>
    </geometry>
  </collision>
</link>

<link name="left_bottom_leg_1">
  <inertial>
    <origin xyz="0.004999999999999165 0.0334295332470692 -0.04524843328414298" rpy="0 0 0"/>
    <mass value="0.06694057104242657"/>
    <inertia ixx="0.000154" iyy="9.6e-05" izz="5.9e-05" ixy="-0.0" iyz="6e-05" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.04 0.089867 -0.144007" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/left_bottom_leg_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0.0050 0.0358 -0.0512" rpy="0.6109 0.0000 0.0000"/>
    <geometry>
      <box size="0.0100 0.0500 0.1750"/>
    </geometry>
  </collision>
</link>

<!-- ========================= motors ========================= -->
<link name="right_motor_1">
  <inertial>
    <origin xyz="0.002611940298508038 -3.875925415914444e-07 -4.822695428494117e-07" rpy="0 0 0"/>
    <mass value="0.022590485913617148"/>
    <inertia ixx="3e-06" iyy="3e-06" izz="3e-06" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.035 0.015302 -0.037518" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/right_motor_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0.0100 0.0000 0.0000" rpy="1.5708 0.4303 -1.5708"/>
    <geometry>
      <box size="0.0300 0.0300 0.0450"/>
    </geometry>
  </collision>
