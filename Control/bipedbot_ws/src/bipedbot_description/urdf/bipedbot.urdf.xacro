<link name="left_motor_1">
  <inertial>
    <origin xyz="-0.002611940298508253 -3.875925402695851e-07 -4.822695418571499e-07" rpy="0 0 0"/>
    <mass value="0.022590485913617148"/>
    <inertia ixx="3e-06" iyy="3e-06" izz="3e-06" ixy="0.0" iyz="-0.0" ixz="0.0"/>
