    <mass value="0.11765454158339926"/>
    <inertia ixx="0.000238" iyy="9.2e-05" izz="0.000152" ixy="5e-06" iyz="-8.2e-05" ixz="4e-06"/>
  </inertial>
  <visual>
    <origin xyz="-0.04 0.01 -0.199931" rpy="0 0 0"/>
