  <collision>
    <origin xyz="-0.0100 0.0000 0.0000" rpy="1.5708 -0.6891 -1.5708"/>
    <geometry>
      <box size="0.0300 0.0300 0.0450"/>
    </geometry>
  </collision>
</link>

<!-- ========================= wheels (no collision, tyres handle contact) ========================= -->
<link name="left_wheel_1">
  <inertial>
    <origin xyz="-3.5058995290215833e-10 -4.003821121052048e-07 -4.778944649383443e-07" rpy="0 0 0"/>
    <mass value="0.02988168724907574"/>
    <inertia ixx="2.1e-05" iyy="1.1e-05" izz="1.1e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.06 0.015302 -0.037518" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/left_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
</link>

<link name="right_wheel_1">
  <inertial>
    <origin xyz="-3.5058860675674097e-10 -4.003821121121437e-07 -4.778944651673278e-07" rpy="0 0 0"/>
    <mass value="0.02988168724907574"/>
    <inertia ixx="2.1e-05" iyy="1.1e-05" izz="1.1e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.06 0.015302 -0.037518" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/right_wheel_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
</link>

<!-- ========================= IMU (no collision) ========================= -->
<link name="imu_link_1">
  <inertial>
    <origin xyz="-0.00800314775699511 0.005842843639794027 0.0010391859500072376" rpy="0 0 0"/>
    <mass value="0.0006222857790364956"/>
    <inertia ixx="0.0" iyy="0.0" izz="0.0" ixy="0.0" iyz="-0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.008 0.0055 -0.215" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/imu_link_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
</link>

<!-- ========================= tyres (ground contact) ========================= -->
<link name="left_tyre_1">
  <inertial>
    <origin xyz="1.8586576635053198e-05 -3.879422003933569e-07 -4.817137699564267e-07" rpy="0 0 0"/>
    <mass value="0.02747331301180858"/>
    <inertia ixx="3.3e-05" iyy="1.8e-05" izz="1.8e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0.06 0.015302 -0.037518" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/left_tyre_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <geometry>
      <cylinder radius="0.037" length="0.0286"/>
    </geometry>
  </collision>
</link>

<link name="right_tyre_1">
  <inertial>
    <origin xyz="1.85865766363022e-05 -3.8794220039682636e-07 -4.817137701784713e-07" rpy="0 0 0"/>
    <mass value="0.02747331301180858"/>
    <inertia ixx="3.3e-05" iyy="1.8e-05" izz="1.8e-05" ixy="0.0" iyz="0.0" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="-0.06 0.015302 -0.037518" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/right_tyre_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 1.5708 0"/>
    <geometry>
      <cylinder radius="0.037" length="0.0286"/>
    </geometry>
  </collision>
</link>

<!-- ========================= joints ========================= -->
<!-- z was 0.033: wheel axle is 0.0375 above base_link and tyre radius is 0.037,
     so with z=0 the tyres sit on the ground. Verify in Gazebo. -->
<joint name="base_joint" type="fixed">
  <parent link="base_footprint"/>
  <child link="base_link" />
  <origin xyz="0 0 0" rpy="0 0 0"/>
</joint>

<joint name="right_top_leg_joint" type="fixed">
  <origin xyz="0.04 -0.01 0.199931" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_top_leg_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="right_bottom_leg_joint" type="fixed">
  <origin xyz="0.0 -0.079867 -0.055924" rpy="0 0 0"/>
  <parent link="right_top_leg_1"/>
  <child link="right_bottom_leg_1"/>
  <axis xyz="1.0 0.0 -0.0"/>
</joint>

<joint name="left_top_leg_joint" type="fixed">
  <origin xyz="-0.04 -0.01 0.199931" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_top_leg_1"/>
  <axis xyz="-1.0 0.0 0.0"/>
</joint>

<joint name="left_bottom_leg_joint" type="fixed">
  <origin xyz="0.0 -0.079867 -0.055924" rpy="0 0 0"/>
  <parent link="left_top_leg_1"/>
  <child link="left_bottom_leg_1"/>
  <axis xyz="-1.0 0.0 -0.0"/>
</joint>

<joint name="right_motor_joint" type="fixed">
  <origin xyz="-0.005 0.074565 -0.106489" rpy="0 0 0"/>
  <parent link="right_bottom_leg_1"/>
  <child link="right_motor_1"/>
</joint>

<joint name="left_motor_joint" type="fixed">
  <origin xyz="0.005 0.074565 -0.106489" rpy="0 0 0"/>
  <parent link="left_bottom_leg_1"/>
  <child link="left_motor_1"/>
</joint>

<joint name="left_wheel_joint" type="continuous">
  <origin xyz="-0.025 0.0 0.0" rpy="0 0 0"/>
  <parent link="left_motor_1"/>
  <child link="left_wheel_1"/>
  <axis xyz="-1.0 -0.0 -0.0"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="0.025 0.0 0.0" rpy="0 0 0"/>
  <parent link="right_motor_1"/>
  <child link="right_wheel_1"/>
  <axis xyz="1.0 0.0 -0.0"/>
</joint>

<joint name="imu_joint" type="fixed">
  <origin xyz="0.008 -0.0055 0.215" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="imu_link_1"/>
</joint>

<joint name="left_tyre_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="left_wheel_1"/>
  <child link="left_tyre_1"/>
</joint>

<joint name="right_tyre_joint" type="fixed">
  <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  <parent link="right_wheel_1"/>
  <child link="right_tyre_1"/>
</joint>

</robot>