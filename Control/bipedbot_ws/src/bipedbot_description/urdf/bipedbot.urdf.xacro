<?xml version="1.0" ?>
<robot name="Biped_bot_1" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:arg name="is_ignition" default="true"/>

<!-- Load Simulated or Real Hardware Interfaces -->
<xacro:arg name="is_sim" default="true"/>

<!-- Include Gazebo Parameters -->
<xacro:include filename="$(find bipedbot_description)/urdf/bipedbot_gazebo.xacro" />

<!-- Include ros2_control Plugins -->
<xacro:include filename="$(find bipedbot_description)/urdf/bipedbot_ros2_control.xacro" />

<!-- Greyish-black material for all visuals -->
<material name="grey_black">
  <color rgba="0.18 0.18 0.2 1.0"/>
</material>

<link name="base_footprint"/>

<!-- ========================= base_link ========================= -->
<link name="base_link">
  <inertial>
    <origin xyz="3.180981950978574e-05 0.0018828231312234408 0.20026420610273285" rpy="0 0 0"/>
    <mass value="0.6871364009577915"/>
    <inertia ixx="0.001278" iyy="0.000754" izz="0.001226" ixy="0.0" iyz="-9e-06" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="0.0000 0.0107 0.1998" rpy="-1.5649 0.0000 3.1416"/>
    <geometry>
      <box size="0.0875 0.0907 0.1418"/>
    </geometry>
  </collision>
</link>

<!-- ========================= legs ========================= -->
<link name="right_top_leg_1">
  <inertial>
