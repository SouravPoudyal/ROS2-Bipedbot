    <origin xyz="-0.04 0.089867 -0.144007" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://bipedbot_description/meshes/right_bottom_leg_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="grey_black"/>
  </visual>
  <collision>
    <origin xyz="-0.0050 0.0358 -0.0512" rpy="0.6109 0.0000 0.0000"/>
    <geometry>
      <box size="0.0100 0.0500 0.1750"/>
    </geometry>
  </collision>
</link>

<link name="left_top_leg_1">
  <inertial>
    <origin xyz="-0.008170600100975561 -0.03442394876428098 -0.024103922387621074" rpy="0 0 0"/>
    <mass value="0.11806434962739475"/>
    <inertia ixx="0.000239" iyy="9.3e-05" izz="0.000153" ixy="-5e-06" iyz="-8.3e-05" ixz="-4e-06"/>
